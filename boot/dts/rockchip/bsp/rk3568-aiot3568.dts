		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA5 0x00>;
		vin-supply = <&vcc5v0_usb>;
		pinctrl-names = "default";
		pinctrl-0 = <0x141>;
		phandle = <0x121>;
	};

	vcc3v3_mipi_panel: vcc3v3-mipi-panel {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_mipi_panel";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PC5 0x00>;
		vin-supply = <&vcc3v3_sys>;
		phandle = <0x99>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vcc3v3_edp_panel: vcc3v3-edp-panel {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_edp_panel";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio2 RK_PD4 0x00>;
		vin-supply = <&vcc3v3_sys>;
		phandle = <0x144>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

