	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x147 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0x148>;
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <&gpio2 RK_PB1 0x01>;
		phandle = <0xa9>;
