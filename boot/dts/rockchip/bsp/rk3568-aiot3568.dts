			timing0 {
				clock-frequency = <0x9093b80>;
				hactive = <0x780>;
				vactive = <0x438>;
				hback-porch = <0xa0>;
				hfront-porch = <0x4b>;
				vback-porch = <0x1c>;
				vfront-porch = <0x12>;
