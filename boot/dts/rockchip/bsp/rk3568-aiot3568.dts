	panel_edp@0 {
		status = "disabled";
		compatible = "simple-panel";
		power-supply = <0x144>;
		backlight = <0x9a>;
		enable-delay-ms = <0x3c>;
		prepare-delay-ms = <0x3c>;
		bus-format = <0x100a>;
