		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x149>;
		WIFI,host_wake_irq = <&gpio2 RK_PB2 0x00>;
		phandle = <0x20f>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0x147 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <&gpio2 RK_PB6 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x14a>;
		pinctrl-1 = <0x14b>;
		BT,reset_gpio = <&gpio2 RK_PB7 0x00>;
		BT,wake_gpio = <&gpio2 RK_PC1 0x00>;
		BT,wake_host_irq = <&gpio2 RK_PC0 0x00>;
		status = "okay";
		phandle = <0x210>;
	};

	test-power {
		status = "okay";
	};

	chosen {
		linux,initrd-end = <0x00 0xa2c8c1a>;
		linux,initrd-start = <0x00 0xa200000>;
		bootargs_ext = "androidboot.boot_devices=fe310000.sdhci,fe330000.nandc";
		bootargs = "storagemedia=emmc androidboot.storagemedia=emmc androidboot.mode=normal  androidboot.dtb_idx=0 androidboot.dtbo_idx=0  androidboot.verifiedbootstate=orange androidboot.serialno=1f5b5f495b53bf3c androidboot.other=3d,01,12 androidboot.o_lvds=00,00,00,00,00,01,00 androidboot.o_mipi2lvds=01,00,00,00,00,01,00 androidboot.o_fb=00,00,00,1920,1080,0,0 androidboot.o_spk=01,da,02,04 androidboot.o_bl=01,00,00,64,00,00,00009c40 androidboot.display=00,10 androidboot.disp_lvds=00,00000000,0000,0000,0000,0000,0000,0000,0000,0000 androidboot.disp_mipi2lvds=00,00000000,0000,0000,0000,0000,0000,0000,0000,0000 androidboot.disp_mipi=00,00000000,0000,0000,0000,0000,0000,0000,0000,0000 androidboot.disp_edp=00,00000000,0000,0000,0000,0000,0000,0000,0000,0000 androidboot.mipi_cmds=00,0000, console=ttyFIQ0 androidboot.baseband=N/A androidboot.wificountrycode=CN androidboot.veritymode=enforcing androidboot.hardware=rk30board androidboot.console=ttyFIQ0 androidboot.verifiedbootstate=orange firmware_class.path=/vendor/etc/firmware init=/init rootwait ro loop.max_part=7 androidboot.selinux=permissive buildvariant=userdebug earlycon=uart8250,mmio32,0xfe660000 androidboot.boot_devices=fe310000.sdhci,fe330000.nandc";
		phandle = <0x211>;
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
